VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Optional: Cloudflare Turnstile site key for Rewards claim/download verification.
# If unset, the built-in checkbox + math challenge is used (no third-party key needed).
# VITE_TURNSTILE_SITE_KEY=0x4AAAAA...

# Never commit a service_role key. Use anon only for Vite.

# Optional: WalletConnect Cloud project id (AppKit). Injected MetaMask works without this.
# VITE_WALLETCONNECT_PROJECT_ID=

# Wallet login uses Supabase Auth Web3 (Ethereum / SIWE). Enable in Dashboard:
# https://supabase.com/dashboard/project/bqccemvnwmtcuzaoouwr/auth/providers
# Also add Redirect URLs: https://hawk-contribute.github.io/Hawkcontribution/**
#   and https://hawk-contribute.github.io/**  and http://localhost:5173/**

